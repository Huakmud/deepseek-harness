{
  "name": "deepseek-harness",
  "version": "0.2.1-rc.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "build:artifacts": "tsx scripts/build.ts --scope artifacts",
    "build:check": "tsx scripts/build.ts --scope check",
    "build:official": "tsx scripts/build.ts --scope artifacts --profile official",
    "build:web": "pnpm --filter @deepseek-ai/dsh-web-frontend run build",
    "build:native-system": "pnpm --filter @deepseek-ai/node-addon-system-workspace run build",
    "typecheck": "tsx scripts/build.ts --scope typecheck",
    "clean": "tsx scripts/clean.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:expected": "vitest run --config vitest.expected.config.ts",
    "test:snapshot": "vitest run --config vitest.snapshot.config.ts",
    "test:snapshot:record": "vitest run --config vitest.snapshot.config.ts --update",
    "test:docs": "tsx scripts/run-gates.ts doc-quick",
    "test:bench": "vitest run --config vitest.bench.config.ts",
    "test:web": "vitest run --config vitest.web.config.ts",
    "lint": "tsx scripts/run-gates.ts ci-static",
    "lint:fix": "oxlint --fix",
    "duplication": "jscpd",
    "hygiene": "tsx scripts/run-gates.ts hygiene",
    "doc-sync": "tsx scripts/run-gates.ts doc-sync",
    "doc-typecheck": "tsc -p tsconfig.host.json --noEmit",
    "verify-translation-pairing": "tsx scripts/verify-translation-pairing.ts",
    "verify-type-equiv": "tsx scripts/verify-type-equiv.ts",
    "website:build": "pnpm --filter @deepseek-ai/website run build",
    "dev:web": "tsx scripts/dev-web.ts",
    "dev:desktop": "tsx apps/desktop/scripts/dev.ts",
    "start:web": "tsx apps/cli/src/index.ts web",
    "start:desktop": "tsx apps/desktop/scripts/dev.ts --skip-build",
    "release:pack": "tsx scripts/release/pack.ts",
    "check:all": "tsx scripts/run-gates.ts check-all",
    "check:windows-wine": "tsx scripts/run-gates.ts ci-windows-complete",
    "demo:ptc": "tsx apps/cli/src/index.ts --profile headless"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-browser-use": "workspace:*",
    "@deepseek-ai/dsh-computer-use": "workspace:*",
    "@deepseek-ai/dsh-cua": "workspace:*",
    "@deepseek-ai/dsh-experimental-browser-use-chrome-devtools-mcp": "workspace:*",
    "@deepseek-ai/dsh-experimental-browser-use-playwright-mcp": "workspace:*",
    "@deepseek-ai/dsh-experimental-browser-use-runtime": "workspace:*",
    "@deepseek-ai/dsh-experimental-browser-use-stagehand-native": "workspace:*",
    "@deepseek-ai/dsh-experimental-claude-code-mods": "workspace:*",
    "@deepseek-ai/dsh-experimental-computer-use-cua-driver-mcp": "workspace:*",
    "@deepseek-ai/dsh-experimental-computer-use-cua-driver-native": "workspace:*",
    "@deepseek-ai/dsh-experimental-cua-macos": "workspace:*",
    "@deepseek-ai/dsh-experimental-tool-worktree": "workspace:*",
    "@deepseek-ai/dsh-experimental-worktree": "workspace:*",
    "@deepseek-ai/dsh-hooks-claude-code": "workspace:*",
    "@deepseek-ai/dsh-hooks-codex": "workspace:*",
    "@deepseek-ai/dsh-llm-replay": "workspace:*",
    "@deepseek-ai/dsh-mcp-client": "workspace:*",
    "@deepseek-ai/dsh-skill-office": "workspace:*",
    "@deepseek-ai/dsh-tool-ralph": "workspace:*",
    "@deepseek-ai/dsh-tool-session-query": "workspace:*",
    "@deepseek-ai/dsh-tool-terminal": "workspace:*",
    "@deepseek-ai/dsh-tool-working-directory": "workspace:*",
    "@deepseek-ai/dsh-tool-workspace-dependencies": "workspace:*",
    "@deepseek-ai/dsh-web-fetch-http": "workspace:*",
    "@deepseek-ai/dsh-working-directory": "workspace:*",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^28.0.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@types/semver": "^7.8.0",
    "@types/spdx-expression-parse": "^4.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@yao-pkg/pkg": "6.21.0",
    "@yarnpkg/cli-dist": "4.18.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "execa": "^10.0.1",
    "extract-zip": "^2.0.1",
    "fast-check": "^4.9.0",
    "fflate": "^0.8.2",
    "istanbul-lib-report": "^3.0.1",
    "js-yaml": "^4.3.2",
    "jscpd": "^5.1.2",
    "jsdom": "29.1.1",
    "lefthook": "^2.1.12",
    "lightningcss": "^1.33.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mermaid": "11.17.2",
    "micromark-extension-gfm": "^3.0.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "papaparse": "5.5.3",
    "pnpm": "11.28.5",
    "publint": "^0.3.24",
    "semver": "^7.8.5",
    "smol-toml": "^1.9.0",
    "spdx-expression-parse": "^5.0.0",
    "tar": "^7.5.22",
    "tsdown": "^0.22.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "8.2.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  }
}
